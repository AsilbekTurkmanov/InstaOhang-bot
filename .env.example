# ─────────────────────────────────────────────
# Telegram Bot Configuration
# ─────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here
ASSISTANT_BOT_TOKEN=your_secondary_assistant_bot_token_here

# ─────────────────────────────────────────────
# Admin Telegram IDs (comma-separated)
# Example: ADMIN_IDS=5246861200,12345678
# ─────────────────────────────────────────────
ADMIN_IDS=5246861200

# ─────────────────────────────────────────────
# PostgreSQL Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/instaohang

# ─────────────────────────────────────────────
# Redis URL
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────
# Limits & Safeguards
# ─────────────────────────────────────────────
MAX_FILE_SIZE_MB=200
DOWNLOAD_TIMEOUT=300
DOWNLOAD_WORKERS=4

# ─────────────────────────────────────────────
# AI Provider Configuration
# ─────────────────────────────────────────────
AI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4o-mini
AI_PROVIDER=openai

# ─────────────────────────────────────────────
# Portfolio API Configuration
# ─────────────────────────────────────────────
PORTFOLIO_API_URL=http://localhost:5056/api/contact
PORTFOLIO_API_TOKEN=your_portfolio_api_token_here
